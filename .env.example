# Dataspace Configuration
# Selects which dataspace (branding, default FDPs, text) this instance serves.
# Must match a directory name under dataspaces/ (e.g. humanitarian, africa).
DATASPACE=humanitarian

# Flask Configuration
FLASK_ENV=development
SECRET_KEY=your-secret-key-change-in-production

# FDP Client Configuration
FDP_TIMEOUT=30

# Logging
LOG_LEVEL=INFO

# Dashboard SPARQL credentials (for aggregate statistics)
# Create a restricted read-only user on your AllegroGraph instances for this
DASHBOARD_SPARQL_USERNAME=
DASHBOARD_SPARQL_PASSWORD=
DASHBOARD_REFRESH_INTERVAL=86400

# Auto-login (sandbox instance only — leave empty on public deployments)
# When set, every visitor is signed in as this user and the login/logout controls
# are hidden. Used by the humanitarian-sandbox dataspace with sandbox_query, whose
# credentials unlock the sandbox repositories on AllegroGraph.
AUTO_LOGIN_USERNAME=
AUTO_LOGIN_PASSWORD=

# Used by docker-compose.override.yml when running the sandbox instance alongside
# the public one (see docker-compose.override.yml.example)
SANDBOX_SECRET_KEY=
SANDBOX_QUERY_PASSWORD=
